# FCP Server Configuration Example
# Copy this file to fcp.toml and customize as needed

[node]
name = "fcp-node-1"
# domain = "example.com"

[transport]
# UDP configuration
[transport.udp]
enabled = true
bind_addr = "0.0.0.0:5060"

# TCP configuration
[transport.tcp]
enabled = true
bind_addr = "0.0.0.0:5060"

# TLS configuration (SIPS)
[transport.tls]
enabled = false
bind_addr = "0.0.0.0:5061"
# cert_path = "/path/to/cert.pem"
# key_path = "/path/to/key.pem"

# Note: TLS support is enabled by default in fcp-server.
# For outbound SIPS connections, the server will automatically use
# system root certificates. No additional configuration is needed
# for client-side TLS connections.

# WebSocket configuration
[transport.ws]
enabled = false
bind_addr = "0.0.0.0:5062"

# WebSocket Secure configuration
[transport.wss]
enabled = false
bind_addr = "0.0.0.0:5063"
# cert_path = "/path/to/cert.pem"
# key_path = "/path/to/key.pem"

# Storage Backend Configuration
# Supports: sqlite (default), postgres, mysql, mongodb
# Note: Build fcp-server with appropriate features to enable backends
#   - SQLite: enabled by default
#   - PostgreSQL: --features storage-postgres
#   - MySQL: --features storage-mysql
#   - MongoDB: --features storage-mongodb
#   - All backends: --features storage-all

[storage]
# SQLite (default) - File-based, great for development and single-node
backend = "sqlite"
connection_string = "sqlite://./data/fcp.db"
max_connections = 10
connection_timeout = "30s"

# PostgreSQL - Production-ready with ACID guarantees
# Requires: cargo build --features storage-postgres
# Setup: createdb fcp && psql fcp < crates/fcp-storage-postgres/migrations/001_initial_schema.sql
# [storage]
# backend = "postgres"
# connection_string = "postgresql://username:password@localhost:5432/fcp"
# max_connections = 20
# connection_timeout = "30s"

# MySQL - Compatible with existing MySQL infrastructure
# Requires: cargo build --features storage-mysql
# Setup: mysql -u root -p -e "CREATE DATABASE fcp CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#        mysql -u root -p fcp < crates/fcp-storage-mysql/migrations/001_initial_schema.sql
# [storage]
# backend = "mysql"
# connection_string = "mysql://username:password@localhost:3306/fcp"
# max_connections = 20
# connection_timeout = "30s"

# MongoDB - NoSQL for large-scale deployments
# Requires: cargo build --features storage-mongodb
# Setup: Collections and indexes are created automatically on first startup
# [storage]
# backend = "mongodb"
# connection_string = "mongodb://username:password@localhost:27017/fcp"
# max_connections = 20
# connection_timeout = "30s"

# MongoDB with authentication and options
# [storage]
# backend = "mongodb"
# connection_string = "mongodb://admin:password@localhost:27017/fcp?authSource=admin"
# max_connections = 20
# connection_timeout = "30s"

# MongoDB Atlas (cloud)
# [storage]
# backend = "mongodb"
# connection_string = "mongodb+srv://username:password@cluster0.mongodb.net/fcp"
# max_connections = 20
# connection_timeout = "30s"

[api]
enabled = true
bind_addr = "127.0.0.1:8080"

[observability]
log_level = "info"
log_format = "compact"  # Options: json, pretty, compact

# [observability.metrics]
# enabled = true
# bind_addr = "127.0.0.1:9090"

# [observability.tracing]
# enabled = false
# endpoint = "http://localhost:4317"
