# FCP Admin API Configuration Example
# Copy to fcp-admin.toml and customize for your environment

[service]
# Service type (always "admin")
service_type = "admin"

# Unique node identifier (auto-generated if not specified)
# node_id = "admin-01"

# Default tenant scope for tenant-scoped admin APIs.
# default_tenant_id = "00000000-0000-0000-0000-000000000000"

[api]
# API bind address. Defaults are loopback-only unless you intentionally expose it
# behind an authenticated gateway or load balancer.
bind_address = "0.0.0.0:8080"

# Enable bearer token authentication
auth_enabled = true

# Bearer authentication token
# IMPORTANT: Use a strong, randomly generated token in production!
# You can also set this via environment variable: FCP_ADMIN_AUTH_TOKEN
auth_token = "change-this-to-a-secure-random-token"

# Phones fetch their configuration from each tenant's provisioning URL
# (docs/PROVISIONING.md); what they are told is [api.provisioning] below.

# Require HTTPS for the provisioning endpoint.  Provisioning responses may
# contain SIP digest credentials (HA1 hashes).  Defaults to true; set to false
# only for local development without a TLS-terminating reverse proxy.
# provisioning_require_https = true

# Keep anonymous tenant signup disabled unless this deployment explicitly offers
# public self-service onboarding.
# allow_public_signup = false

# What provisioned phones are told (docs/PROVISIONING.md §5): where they
# register (unset, the realm `fcp.local`, which no phone can reach), how,
# their time server, and the address they reach this admin at.
# [api.provisioning]
# sip_server = "sip.example.com"
# sip_port = 5061
# sip_transport = "tls"
# ntp_server = "pool.ntp.org"
# public_url = "https://pbx.example.com"

# Where vendors' redirection services are reached (docs/PROVISIONING.md
# §10); the vendors' own by default. Tenants give their own accounts.
# [api.redirection]
# yealink_rps_url = "https://api-dm.yealink.com:8443"
# poly_ztp_url = "https://ztpconsole.polycom.com/inboundservlet/GenericServlet"

# Where firmware images the platform administrator uploads are kept, and
# how large one may be (docs/PROVISIONING.md §11); unset, none can be.
# [api.firmware]
# directory = "/var/lib/fcp/firmware"
# max_image_mb = 1024

[storage]
# PostgreSQL is the one backend. Migrations run at startup.
database_url = "postgresql://fcp_user:password@localhost:5432/fcp"

# A streaming read replica for configuration reads, and how far behind
# it may be before reads go back to the primary (docs/MULTI_REGION.md).
# read_replica_url = "postgresql://fcp_user:password@replica:5432/fcp"
# max_replica_lag_secs = 5

# Database connections per instance
max_connections = 50
min_connections = 5

[logging]
# Log level: "trace", "debug", "info", "warn", "error"
level = "info"

# Log format: "json", "pretty", "compact"
# Use "json" for production (easier to parse), "pretty" for development
format = "json"

# [conference]
# A conference server's HTTP API, for live room controls in the admin UI
# (video layout, pin, spotlight, participant video on/off, dial-out). Any
# conference node will do: it forwards to the nodes hosting a room itself.
# Without it the live endpoints answer 503.
# server_url = "http://fcp-conference-server:8090"
# Bearer token for that API when it has http.auth_enabled.
# auth_token = "conference-server-api-token"

# [webhooks]
# Tenants' webhook tests and replays are sent from here (docs/WEBHOOKS.md).
# Reach loopback and private addresses too: a lab only, and set it as the
# events server's [webhook] allow_private_targets is.
# allow_private_targets = false
# request_timeout_secs = 10

# ============================================================
# Example Configurations for Different Deployment Scenarios
# ============================================================

# --- Development (SQLite) ---
# [storage]
# storage_type = "sqlite"
# sqlite_path = "dev-admin.db"
# [logging]
# level = "debug"
# format = "pretty"

# --- Production (PostgreSQL with PgBouncer) ---
# [storage]
# storage_type = "postgres"
# postgres_url = "postgres://api_user:secure_password@pgbouncer:6432/fcp"
# max_connections = 50
# min_connections = 10
# [logging]
# level = "info"
# format = "json"

# --- High Availability (Multiple Admin Instances) ---
# Deploy 3+ instances with load balancer
# Each instance connects to same database
# Use PgBouncer for connection pooling
# Configure health checks: GET /api/v1/health
