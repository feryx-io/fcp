#!/bin/bash
# The GPU box, in one word each: up, down, status, ssh, sync, log.
#
#   deploy/gcp-gpu/gpu-box up       # create the VM (the disk stays as it was)
#   deploy/gcp-gpu/gpu-box down     # destroy the VM, keep the disk
#   deploy/gcp-gpu/gpu-box status   # is it running, what does it cost
#   deploy/gcp-gpu/gpu-box ssh      # a shell on it, through IAP
#   deploy/gcp-gpu/gpu-box sync [dir]  # copy this checkout (or one directory) to ~/fcp on the box
#   deploy/gcp-gpu/gpu-box log      # the setup log (driver, FFmpeg build)
#   deploy/gcp-gpu/gpu-box move <zone>  # follow Spot capacity: the disk goes by snapshot
#   deploy/gcp-gpu/gpu-box test [args]  # sync, then the GPU tests on the box (forge-video-hw, the conference server on cuda:0)
#
# Needs: gcloud logged in, `gcloud auth application-default login` done
# once for Terraform, and terraform on PATH.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
cd "$here"
name="$(terraform output -raw disk 2>/dev/null || echo fcp-gpu)"
project="${GPU_BOX_PROJECT:-brayz-dev}"
# Terraform's google provider wants application default credentials; a
# plain `gcloud auth login` is enough when its token is handed over.
if [ -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] && [ ! -f "$HOME/.config/gcloud/application_default_credentials.json" ]; then
  GOOGLE_OAUTH_ACCESS_TOKEN="$(gcloud auth print-access-token)"
  export GOOGLE_OAUTH_ACCESS_TOKEN
fi
zone="$(terraform output -raw zone 2>/dev/null || echo us-central1-a)"

case "${1:-}" in
  up)
    terraform init -input=false >/dev/null
    terraform apply -input=false -auto-approve -var up=true
    echo "waiting for the box to answer ssh"
    for _ in $(seq 1 30); do
      if gcloud compute ssh "$name" --project "$project" --zone "$zone" --tunnel-through-iap --quiet --command true >/dev/null 2>&1; then
        break
      fi
      sleep 10
    done
    echo "up; setup continues on the box (gpu-box log to watch it)"
    ;;
  down)
    terraform apply -input=false -auto-approve -var up=false
    ;;
  status)
    gcloud compute instances describe "$name" --project "$project" --zone "$zone" \
      --format="value(status,machineType.basename(),scheduling.provisioningModel,creationTimestamp)" 2>/dev/null \
      || echo "down (disk kept: $name)"
    ;;
  ssh)
    shift
    gcloud compute ssh "$name" --project "$project" --zone "$zone" --tunnel-through-iap "$@"
    ;;
  sync)
    # The working tree — or one directory of it, `gpu-box sync
    # external/forge-media` — to ~/fcp on the box, without build output
    # or git objects. A tar pipe: rsync is not a given on either end.
    sub="${2:-.}"
    ( cd "$repo" && tar czf - --exclude=target --exclude=.git --exclude=node_modules --exclude=dist "$sub" ) \
      | gcloud compute ssh "$name" --project "$project" --zone "$zone" --tunnel-through-iap --quiet \
          --command "mkdir -p fcp && tar xzf - -C fcp"
    ;;
  log)
    gcloud compute ssh "$name" --project "$project" --zone "$zone" --tunnel-through-iap --quiet \
      --command "sudo tail -n ${2:-40} -f /var/log/gpu-box-setup.log"
    ;;
  move)
    # Follow capacity to another zone: the disk is zonal, so it goes by
    # snapshot. The VM must be down. Writes the new zone to
    # zone.auto.tfvars (gitignored) so every later command uses it.
    to="${2:?usage: gpu-box move <zone>}"
    [ "$to" != "$zone" ] || { echo "already in $to"; exit 0; }
    if gcloud compute instances describe "$name" --project "$project" --zone "$zone" >/dev/null 2>&1; then
      echo "the VM is up in $zone; gpu-box down first"; exit 1
    fi
    snap="$name-move-$(date +%Y%m%d%H%M%S)"
    gcloud compute disks snapshot "$name" --project "$project" --zone "$zone" --snapshot-names "$snap" --quiet
    gcloud compute disks create "$name" --project "$project" --zone "$to" --source-snapshot "$snap" --type pd-balanced --quiet
    terraform state rm google_compute_disk.boot >/dev/null
    terraform import -input=false -var "zone=$to" google_compute_disk.boot "projects/$project/zones/$to/disks/$name" >/dev/null
    printf 'zone = "%s"\n' "$to" > zone.auto.tfvars
    gcloud compute disks delete "$name" --project "$project" --zone "$zone" --quiet
    gcloud compute snapshots delete "$snap" --project "$project" --quiet
    echo "moved to $to; gpu-box up"
    ;;
  test)
    # The tests that need the hardware (design §15.7, §15.9): forge-media's
    # forge-video-hw crate, and the conference server built with
    # `video-hwaccel` (and `recording-mp4`, for the room recorded off
    # NVENC) and pointed at the GPU. Extra arguments go to `cargo test`
    # (a test name, `--release`).
    shift
    "$0" sync
    gcloud compute ssh "$name" --project "$project" --zone "$zone" --tunnel-through-iap --quiet \
      --command "source /etc/profile.d/gpu-box.sh; set -e; cd fcp/external/forge-media && cargo test -p forge-video-hw $* -- --nocapture; cd ~/fcp && FCP_TEST_VIDEO_DEVICE=cuda:0 OPENSSL_NO_VENDOR=1 cargo test -p fcp-conference-server --features video-hwaccel,recording-mp4 $* -- --nocapture"
    ;;
  *)
    sed -n '2,17p' "$0"
    exit 1
    ;;
esac
