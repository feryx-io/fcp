# Multi-stage build for fcp-ivr (fcp-ivr)
FROM rust:1.92 AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external
RUN cargo build --release -p fcp-ivr

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/fcp-ivr /app/fcp-ivr
RUN mkdir -p /app/data

EXPOSE 5070/udp
EXPOSE 5070/tcp
EXPOSE 8086
EXPOSE 22000-22999/udp

CMD ["/app/fcp-ivr", "--config", "/app/fcp-ivr.toml"]
