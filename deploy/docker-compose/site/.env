# The site stack's settings and secrets (docs/SITE_SETUP.md). A site is a
# tenant's own stack on the tenant's network, enrolled to a cloud and kept
# in step by fcp-link (docs/HYBRID_CONTROL_PLANE.md). Every FCP_* value
# here is read by the binary of the same prefix through its environment
# overrides. Change every secret before exposing the stack to anything
# but yourself.

# Which FCP images to run: `local` builds them here with
# `docker compose up -d --build`; `nightly` (or a commit sha) pulls what
# the Images workflow pushed to ghcr.io/thevoiceguy/fcp-<service>.
FCP_IMAGE_TAG=local

# This host's LAN address: what the site's phones dial and what the call
# manager puts in SDP.
HOST_IP=192.168.1.100

# The cloud. The link enrolls at the cloud admin's enroll listener and
# heartbeats at its link listener (the compose cloud publishes them on
# 8446 and 8447); the site's admin names the cloud's admin when it
# refuses a write to something the cloud owns.
FCP_LINK_CLOUD_URL=https://cloud.example.com:8446
FCP_LINK_LINK_URL=https://cloud.example.com:8447
FCP_CLOUD_ADMIN_URL=https://cloud.example.com:8444

# The one-time enrollment token from the cloud's Sites page (or
# POST /v1/sites). Needed until the link's state volume holds a
# certificate; blank it afterwards.
FCP_LINK_ENROLLMENT_TOKEN=paste-the-token-from-the-cloud-here

# Postgres, run by this compose file as `postgres`, user `fcp`, database `fcp`.
POSTGRES_PASSWORD=fcp-site-postgres-change-me

# fcp-admin: the operator token for the site's own admin. Phones fetch
# from the site's provisioning URL (docs/PROVISIONING.md).
FCP_ADMIN_AUTH_TOKEN=fcp-site-admin-token-change-me

# fcp-call-manager: its operator routes, which the site's admin also calls.
FCP_CALL_MANAGER_API_TOKEN=fcp-site-call-manager-token-change-me
