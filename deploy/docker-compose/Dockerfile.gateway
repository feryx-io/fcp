# Multi-stage build for fcp-api-gateway
FROM rust:1.92 as builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external

RUN cargo build --release -p fcp-api-gateway

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/fcp-api-gateway /app/fcp-api-gateway

EXPOSE 8000

CMD ["/app/fcp-api-gateway"]
