# Multi-stage build for fcp-media-server
FROM rust:1.92 as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external

# Build fcp-media in release mode
RUN cargo build --release -p fcp-media-server

# Runtime stage
FROM debian:trixie-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/fcp-media /app/fcp-media

# Create data directories
RUN mkdir -p /var/lib/fcp/media/recordings /var/lib/fcp/media/prompts

# Expose HTTP API and RTP port range
EXPOSE 8085
EXPOSE 30000-30999/udp

# Run the binary
CMD ["/app/fcp-media", "--config", "/app/fcp-media-server.toml"]
