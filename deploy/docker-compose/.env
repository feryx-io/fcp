# The compose stack's settings and secrets (docs/SHIP_AND_OPERATE.md phase 3).
# Every FCP_* value here is read by the binary of the same prefix through
# the environment overrides every binary has; the compose file hands the
# shared ones to the other services that need them. Change every secret
# before exposing the stack to anything but yourself.

# Which FCP images to run: `local` is what `docker compose up -d --build`
# builds here; `nightly` (or a commit sha) is what the Images workflow pushed
# to ghcr.io/thevoiceguy/fcp-<service> — then `docker compose pull` and
# `up -d --no-build` need no Rust toolchain (docs/NIGHTLY_STACK.md).
FCP_IMAGE_TAG=local

# The Docker host's LAN address: what phones, browsers and carriers dial,
# and what the host-network services put in SDP. Containers on the bridge
# network cannot discover it.
HOST_IP=192.168.1.100

# Postgres, run by this compose file as `postgres`, user `fcp`, database `fcp`.
POSTGRES_PASSWORD=fcp-compose-postgres-change-me

# fcp-admin: the operator token. Phones fetch from each tenant's
# provisioning URL (docs/PROVISIONING.md), which needs no token here.
FCP_ADMIN_AUTH_TOKEN=fcp-compose-admin-token-change-me

# fcp-events-server: what every producer posts events with.
FCP_EVENTS_AUTH_TOKEN=fcp-compose-events-token-change-me

# fcp-call-manager: its operator routes, which the admin also calls.
FCP_CALL_MANAGER_API_TOKEN=fcp-compose-call-manager-token-change-me

# fcp-conference: its HTTP API, and the secret join tokens are signed with
# (the admin mints them, the conference server verifies them).
FCP_CONFERENCE_AUTH_TOKEN=fcp-compose-conference-token-change-me
FCP_CONFERENCE_JOIN_SECRET=fcp-compose-join-secret-change-me

# fcp-media and fcp-webrtc-gw: their API tokens (comma-separated lists).
FCP_MEDIA_AUTH_TOKENS=fcp-compose-media-token-change-me
FCP_WEBRTC_GW_AUTH_TOKENS=fcp-compose-webrtc-token-change-me

# fcp-registrar (the optional `registrar` profile): its operator routes.
FCP_REGISTRAR_API_TOKEN=fcp-compose-registrar-token-change-me

# fcp-ivr, fcp-voicemail, fcp-presence: their operator routes.
FCP_IVR_API_TOKEN=fcp-compose-ivr-token-change-me
FCP_VOICEMAIL_API_TOKEN=fcp-compose-voicemail-token-change-me
FCP_PRESENCE_API_TOKEN=fcp-compose-presence-token-change-me

# fcp-sbc: its health and metrics routes.
FCP_SBC_HEALTH_API_TOKEN=fcp-compose-sbc-token-change-me

# fcp-tts: what the call manager, IVR and voicemail server ask for speech with.
FCP_TTS_AUTH_TOKENS=fcp-compose-tts-token-change-me
