# Multi-stage build for fcp-link
FROM rust:1.92 as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external

# Build fcp-link in release mode
RUN cargo build --release -p fcp-link

# Runtime stage
FROM debian:trixie-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/fcp-link /app/fcp-link

# The link's state: its key, its certificate and the site's secret from
# enrollment, and the sync cursor (docs/SITE_SETUP.md).
RUN mkdir -p /app/data

# Expose the HTTP health endpoint
EXPOSE 8096

# Run the binary
CMD ["/app/fcp-link", "--config", "/app/fcp-link.toml"]
