# Multi-stage build for fcp-registrar
FROM rust:1.98 as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external

# Build fcp-registrar in release mode
RUN cargo build --release -p fcp-registrar

# Runtime stage
FROM debian:trixie-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/fcp-registrar /app/fcp-registrar

# Create data directory
RUN mkdir -p /app/data

# Expose SIP ports (UDP + TCP) and HTTP health endpoint
EXPOSE 5062/udp
EXPOSE 5062/tcp
EXPOSE 8083

# Run the binary
CMD ["/app/fcp-registrar", "--config", "/app/fcp-registrar.toml"]
