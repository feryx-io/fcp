# Multi-stage build for fcp-conference-server
#
# Rooms carry video in VP8 (the system libvpx) and H.264 (OpenH264, built
# from source): the codecs a browser through the gateway and a softphone
# send (docs/SOFTPHONE_VIDEO.md §2.6). The builder is trixie, as the
# runtime is, so the libvpx linked is the one installed.
FROM rust:1.98-trixie AS builder

# Install build dependencies (clang for libvpx's bindings, nasm for
# OpenH264's assembly)
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    clang \
    libclang-dev \
    nasm \
    libvpx-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external

# Build fcp-conference in release mode
RUN cargo build --release -p fcp-conference-server --features video-vpx,video-openh264

# Runtime stage
FROM debian:trixie-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libvpx9 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/fcp-conference /app/fcp-conference

# Create data directories
RUN mkdir -p /app/data /var/fcp/conference/recordings /var/fcp/conference/announcements

# Expose SIP ports (UDP + TCP), HTTP API, and RTP port range
EXPOSE 5074/udp
EXPOSE 5074/tcp
EXPOSE 8090
EXPOSE 20000-20999/udp

# Run the binary
CMD ["/app/fcp-conference", "--config", "/app/fcp-conference-server.toml"]
