# Multi-stage build for fcp-tts (fcp-tts-server) with Piper, the default
# engine (docs/SPEECH.md): a native binary and one public-domain voice, no
# Python — small enough for every stack to run, so prompts, greetings and
# voicemail are never silence (docs/DEEP_TESTING.md Q-D8a). Kokoro and the
# local Whisper worker are in fcp-tts-full (Dockerfile.tts-full).
FROM rust:1.98 AS builder

RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external
RUN cargo build --release -p fcp-tts-server

# The same Debian release as the builder, so the binary's libc matches.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/docker-compose/scripts/fetch-piper.sh /tmp/fetch-piper.sh
RUN sh /tmp/fetch-piper.sh /opt/piper /opt/piper-voices && rm /tmp/fetch-piper.sh

WORKDIR /app
COPY --from=builder /app/target/release/fcp-tts /app/fcp-tts
RUN mkdir -p /var/lib/fcp/tts_cache

EXPOSE 8093

CMD ["/app/fcp-tts", "--config", "/app/fcp-tts-server.toml"]
