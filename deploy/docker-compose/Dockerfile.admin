# Multi-stage build for fcp-admin

# The admin UI, built into the dist/ the binary embeds (fcp-admin-ui).
# Without it the binary serves a placeholder page at /admin.
FROM node:22-trixie-slim AS ui
WORKDIR /ui
COPY crates/fcp-admin-ui/ui/package.json crates/fcp-admin-ui/ui/package-lock.json ./
RUN npm ci
COPY crates/fcp-admin-ui/ui ./
# vite writes to ../dist, here /dist.
RUN npm run build

FROM rust:1.98 as builder

# Install build dependencies
# libxmlsec1-dev and libclang for SAML sign-in (the `saml` feature, docs/SSO.md)
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    libxmlsec1-dev \
    libclang-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external
COPY --from=ui /dist ./crates/fcp-admin-ui/dist

# Build fcp-admin in release mode, with SAML sign-in
RUN cargo build --release -p fcp-admin --features saml

# Runtime stage
FROM debian:trixie-slim

# Install runtime dependencies
# libxmlsec1t64-openssl brings xmlsec, libxslt and libxml2 for SAML
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libxmlsec1t64-openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/fcp-admin /app/fcp-admin

# Create data directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 8080

# Run the binary
CMD ["/app/fcp-admin"]
