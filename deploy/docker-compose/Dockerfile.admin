# Multi-stage build for fcp-admin
FROM rust:1.92 as builder

# Install build dependencies
# libxmlsec1-dev and libclang for SAML sign-in (the `saml` feature, docs/SSO.md)
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    libxmlsec1-dev \
    libclang-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external

# Build fcp-admin in release mode, with SAML sign-in
RUN cargo build --release -p fcp-admin --features saml

# Runtime stage
FROM debian:trixie-slim

# Install runtime dependencies
# libxmlsec1t64-openssl brings xmlsec, libxslt and libxml2 for SAML
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libxmlsec1t64-openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/fcp-admin /app/fcp-admin

# Create data directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 8080

# Run the binary
CMD ["/app/fcp-admin"]
