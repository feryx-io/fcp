# Multi-stage build for fcp-voicemail (fcp-voicemail-server)
FROM rust:1.98 AS builder

RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY external ./external
RUN cargo build --release -p fcp-voicemail-server

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/fcp-voicemail /app/fcp-voicemail
RUN mkdir -p /app/data

EXPOSE 5072/udp
EXPOSE 5072/tcp
EXPOSE 8087
EXPOSE 24000-24999/udp

CMD ["/app/fcp-voicemail", "--config", "/app/fcp-voicemail-server.toml"]
