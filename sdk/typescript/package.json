{
  "name": "@fcp/sdk",
  "version": "0.25.0",
  "description": "The FCP admin API's TypeScript client, generated from its OpenAPI contract",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "openapi-typescript ../../docs/openapi.json -o src/schema.ts",
    "build": "tsc -p .",
    "test": "tsc -p . && node --test test/*.test.js"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.6.0"
  }
}
